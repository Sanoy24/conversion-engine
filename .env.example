# ============================================================
# Conversion Engine — Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Used when APP_ENV=development
DEV_MODEL=deepseek/deepseek-chat-v3-0324
# Used when APP_ENV=production
EVAL_MODEL=anthropic/claude-sonnet-4-20250514

# --- Email (Resend) ---
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=outbound@yourdomain.com
# Signing secret (whsec_...) from Resend -> Webhooks; verifies webhook signatures.
RESEND_WEBHOOK_SECRET=

# --- SMS (Africa's Talking) ---
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_SHORTCODE=your_sandbox_shortcode_here
AT_ENVIRONMENT=sandbox
# Africa's Talking doesn't sign callbacks: set a random token here and use
# https://<host>/webhooks/sms/inbound?token=<AT_WEBHOOK_TOKEN> as the callback URL.
AT_WEBHOOK_TOKEN=

# --- CRM (HubSpot) ---
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here
HUBSPOT_PORTAL_ID=your_portal_id_here
USE_HUBSPOT_MCP=false

# --- Calendar (Cal.com) ---
CALCOM_API_KEY=your_calcom_api_key_here
CALCOM_BASE_URL=https://api.cal.com
CALCOM_EVENT_TYPE_ID=1
# Secret entered on the Cal.com webhook; verifies X-Cal-Signature-256.
CALCOM_WEBHOOK_SECRET=

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Application ---
APP_ENV=development
# Required on /api/* (X-API-Key or Authorization: Bearer). Unset = open API in
# development, every /api/* request rejected in production.
API_KEY=
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# --- Conversation storage ---
# SQLite file that keeps threads and the suppression list across restarts.
# Empty = in memory only.
CONVERSATION_DB_PATH=./data/conversations.db

# --- Unsubscribe (required before live email) ---
# Public URL of this app; unsubscribe links in every email point here.
PUBLIC_BASE_URL=
# Signs unsubscribe links. Generate once and keep it: changing it breaks
# links already sent. e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
UNSUBSCRIBE_SECRET=

# --- Kill Switch ---
# When false (default), NO email or SMS is delivered: all outbound is logged
# to the sink instead. Set to true only once you have reviewed drafts and
# confirmed you are permitted to contact the recipients.
LIVE_OUTBOUND_ENABLED=false

# --- Playbook ---
# Directory with playbook.yaml (company identity, voice, ICP segments).
PLAYBOOK_DIR=./playbooks/example

# --- Public data (run `uv run python -m scripts.fetch_data` to populate) ---
CRUNCHBASE_DATA_PATH=./data/crunchbase_odm_sample.json
LAYOFFS_DATA_PATH=./data/layoffs.csv
JOB_POSTS_SNAPSHOT_PATH=./data/job_posts_snapshot.json
